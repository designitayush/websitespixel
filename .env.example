# Copy to .env.local for local testing. Real values live in Vercel env vars.

# ---- Required -------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ---- Email --------------------------------------------------------------
# BOOKING_TO=teamwebsitespixel@gmail.com      where notifications land
# CONTACT_TO=hello@websitespixel.com          /contact/ messages only
# CONTACT_TO is optional. Unset, contact mail follows BOOKING_TO, and if that
# is unset too it falls back to hello@websitespixel.com - the address the
# /contact/ page displays. The fallback must never contradict the page.
# BOOKING_FROM=WebsitesPixel <hello@websitespixel.com>   must be a verified domain
# BOOKING_TZ=Asia/Kolkata                     the timezone your slots are published in
# BOOKING_MINUTES=30                          call length
# BOOKING_MEETING_URL=https://meet.google.com/xxx-xxxx-xxx

# ---- Airtable (storage) ---------------------------------------------------
# Personal access token with data.records:write (and :read for dedupe).
# Leave unset and the site still works; bookings just are not stored.
# AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxx
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# AIRTABLE_BOOKINGS_TABLE=Bookings
# AIRTABLE_SUBSCRIBERS_TABLE=Subscribers
#
# Bookings table columns:    Reference, Name, Email, Phone, Company, Website,
#                            Service, Project, Slot, Start, Client Timezone,
#                            Status, Source
# Subscribers table columns: Email, Status, Source
# Any column you leave out is dropped automatically rather than losing the row.

# ---- Optional extra sink --------------------------------------------------
# Fires a JSON POST per booking, for Make / n8n / Zapier / Sheets.
# BOOKING_WEBHOOK_URL=https://hook.example.com/xyz
# BOOKING_WEBHOOK_TOKEN=sent as an Authorization: Bearer header

# ---- Analytics ------------------------------------------------------------
# Not env vars. Clarity is hardcoded in index.html; the GA4 Measurement ID
# goes in the WP_ANALYTICS object at the top of index.html.
