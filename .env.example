# Environment variables - copy to .env.local

# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://websitespixel.com

# Contact details shown on the site (defaults in src/lib/config.ts)
NEXT_PUBLIC_CONTACT_EMAIL=sales.wearewebsitedesigners@gmail.com
NEXT_PUBLIC_PHONE=+1 (972) 713-5586
NEXT_PUBLIC_WHATSAPP=+1 (814) 790-7668

# Booking URL for strategy calls
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/wearewebsitedesigners/30min

# Server-side form endpoints (leave empty to accept submissions without forwarding)
LEAD_MAGNET_ENDPOINT=
CONTACT_FORM_ENDPOINT=
